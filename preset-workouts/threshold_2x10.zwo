<workout_file>
  <author>opencycling-workouts</author>
  <name>Threshold 2x10</name>
  <description>阈值课：热身 10 分钟，2×10 分钟 100% FTP（组间 6 分钟 55%），冷身 6 分钟。核心阈值能力课。</description>
  <sportType>bike</sportType>
  <workout>
    <Warmup Duration="600" PowerLow="0.40" PowerHigh="0.80" Cadence="95"/>
    <SteadyState Duration="600" Power="1.00" Cadence="95" name="Threshold 1"/>
    <SteadyState Duration="360" Power="0.55" Cadence="90" name="Recovery"/>
    <SteadyState Duration="600" Power="1.00" Cadence="95" name="Threshold 2"/>
    <Cooldown Duration="360" PowerLow="0.80" PowerHigh="0.40" Cadence="90"/>
  </workout>
</workout_file>
