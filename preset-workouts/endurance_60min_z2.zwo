<workout_file>
  <author>opencycling-workouts</author>
  <name>Endurance 60min Z2</name>
  <description>基础有氧耐力课：热身 6 分钟，主段 45 分钟 70% FTP（Z2），冷身 5 分钟。适合长距离有氧基础。</description>
  <sportType>bike</sportType>
  <workout>
    <Warmup Duration="360" PowerLow="0.40" PowerHigh="0.70" Cadence="90"/>
    <SteadyState Duration="2700" Power="0.70" Cadence="90" name="Endurance"/>
    <Cooldown Duration="300" PowerLow="0.70" PowerHigh="0.40" Cadence="90"/>
  </workout>
</workout_file>
