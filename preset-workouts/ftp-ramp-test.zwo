<workout_file>
  <author>OpenCycling-compatible</author>
  <name>FTP Ramp Test</name>
  <description>Ramp test: start at 100W, rise 20W every minute until you cannot continue. FTP estimated as 75% of your best 1-minute power.</description>
  <sportType>bike</sportType>
  <tags>
    <tag name="ftp-test"/>
  </tags>
  <workout>
    <Warmup Duration="900" PowerLow="0.35" PowerHigh="0.75" Cadence="90"/>
    <SteadyState Duration="60" Power="1.00" name="Start 100% FTP"/>
    <SteadyState Duration="60" Power="1.05" name="Ramp"/>
    <SteadyState Duration="60" Power="1.10" name="Ramp"/>
    <SteadyState Duration="60" Power="1.15" name="Ramp"/>
    <SteadyState Duration="60" Power="1.20" name="Ramp"/>
    <SteadyState Duration="60" Power="1.25" name="Ramp"/>
    <SteadyState Duration="60" Power="1.30" name="Ramp"/>
    <SteadyState Duration="60" Power="1.35" name="Ramp"/>
    <SteadyState Duration="60" Power="1.40" name="Ramp"/>
    <SteadyState Duration="60" Power="1.45" name="Ramp"/>
    <SteadyState Duration="60" Power="1.50" name="Ramp"/>
    <Cooldown Duration="600" PowerLow="0.50" PowerHigh="0.30" Cadence="90"/>
  </workout>
</workout_file>
