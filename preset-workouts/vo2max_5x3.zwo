<workout_file>
  <author>opencycling-workouts</author>
  <name>VO2max 5x3</name>
  <description>VO2max 课：热身 12 分钟，5×3 分钟 115% FTP（组间 3 分钟 50%），冷身 6 分钟。提升最大摄氧量。</description>
  <sportType>bike</sportType>
  <workout>
    <Warmup Duration="720" PowerLow="0.40" PowerHigh="0.85" Cadence="90"/>
    <SteadyState Duration="180" Power="1.15" Cadence="95" name="VO2 1"/>
    <SteadyState Duration="180" Power="0.50" Cadence="90" name="Recovery"/>
    <SteadyState Duration="180" Power="1.15" Cadence="95" name="VO2 2"/>
    <SteadyState Duration="180" Power="0.50" Cadence="90" name="Recovery"/>
    <SteadyState Duration="180" Power="1.15" Cadence="95" name="VO2 3"/>
    <SteadyState Duration="180" Power="0.50" Cadence="90" name="Recovery"/>
    <SteadyState Duration="180" Power="1.15" Cadence="95" name="VO2 4"/>
    <SteadyState Duration="180" Power="0.50" Cadence="90" name="Recovery"/>
    <SteadyState Duration="180" Power="1.15" Cadence="95" name="VO2 5"/>
    <Cooldown Duration="360" PowerLow="0.85" PowerHigh="0.40" Cadence="90"/>
  </workout>
</workout_file>
