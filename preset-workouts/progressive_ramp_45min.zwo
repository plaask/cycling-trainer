<workout_file>
  <author>opencycling-workouts</author>
  <name>Progressive Ramp 45min</name>
  <description>渐进强度课：热身 8 分钟，30 分钟从 70% 线性爬升至 95% FTP（单段 ramp），冷身 7 分钟。适合 FTP 递增训练或赛前激活。</description>
  <sportType>bike</sportType>
  <workout>
    <Warmup Duration="480" PowerLow="0.40" PowerHigh="0.70" Cadence="90"/>
    <Warmup Duration="1800" PowerLow="0.70" PowerHigh="0.95" Cadence="90" name="Progressive ramp"/>
    <Cooldown Duration="420" PowerLow="0.95" PowerHigh="0.40" Cadence="90"/>
  </workout>
</workout_file>
