<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher foreground: a simple power/cadence dial — a ring with a needle and
  a crank-arm dot. Drawn inside the 72x72 safe zone of the 108x108 adaptive
  icon canvas.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- outer dial ring -->
    <path
        android:pathData="M54,30 A24,24 0 1,1 53.9,30"
        android:strokeColor="#7FD1B9"
        android:strokeWidth="5"
        android:strokeLineCap="round" />

    <!-- needle pointing up-right -->
    <path
        android:pathData="M54,54 L69,39"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round" />

    <!-- hub -->
    <path
        android:pathData="M54,48 A6,6 0 1,1 53.9,48"
        android:fillColor="#FFFFFF" />

    <!-- crank arm -->
    <path
        android:pathData="M38,70 L70,70"
        android:strokeColor="#F2A65A"
        android:strokeWidth="5"
        android:strokeLineCap="round" />
</vector>
